# Окружение стенда ФСП.Подбор (Арх. 13.3).
#
#   cp .env.example .env && docker compose up --build        — локальный запуск без правки файла
#   make init-env                                            — .env для публичного стенда со случайными секретами
#
# Значения ниже — рабочие учебные. При APP_ENV=production приложение не стартует с секретами dev-only-…,
# с COOKIE_SECURE=false и (при почте через Mailpit) без MAIL_UI_USER и MAIL_UI_PASSWORD.

# --- процесс ---------------------------------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=ФСП.Подбор
# Внешний адрес: ссылки в письмах, redirect_uri ФСП ID, проверка заголовка Origin.
PUBLIC_BASE_URL=http://localhost:8080
# Дополнительные разрешённые Origin через запятую (сквозные тесты в контейнере: http://web). Обычно пусто.
ALLOWED_ORIGINS=
WEB_CONCURRENCY=1
LOG_LEVEL=info
# false — недостающий модуль пропускается с предупреждением (так стенд поднимается, пока пакеты в работе);
# true — запуск падает. Сборочный пакет выставляет true, когда модули P0 на месте.
WIRING_STRICT=true

# --- база ------------------------------------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# --- секреты (учебные; публичный стенд — только случайные: make init-env) --------------------------------------------
# Ключ HMAC для seed вариантов и форм теста: с учебным значением варианты может воспроизвести любой.
ASSESSMENT_SECRET=dev-only-assessment-secret-change-me
# Служебные действия платформы и демо-ФСП (заголовок X-Admin-Token).
ADMIN_TOKEN=dev-only-admin-token-change-me

# --- сессия и регистрация --------------------------------------------------------------------------------------------
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
# По умолчанию 5; на стенде 50, чтобы жюри из одной сети не упиралось в лимит.
SIGNUP_IP_LIMIT_PER_HOUR=50
# От каких адресов приложение принимает X-Real-IP: подсеть compose (STAND_SUBNET в compose.yml). Менять вместе.
TRUSTED_PROXY_CIDRS=172.28.5.0/24
# Адрес внешнего прокси с HTTPS перед web; обязателен на публичном стенде за Caddy или nginx.
NGINX_REAL_IP_FROM=
# Карантин адреса после удаления аккаунта, сутки (0–30, дробное допустимо). По умолчанию 30.
# На стенде — около 10 минут, чтобы проверивший удаление мог зарегистрироваться на тот же адрес снова.
REREGISTER_COOLDOWN_DAYS=0.007

# --- время -----------------------------------------------------------------------------------------------------------
APP_TZ=Europe/Moscow

# --- почта -----------------------------------------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=noreply@localhost
# Настоящий SMTP публичного стенда (тогда MAILPIT_PUBLIC_URL оставить пустым).
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
# Ссылка на ящик стенда в интерфейсе; пусто — подсказки нет.
MAILPIT_PUBLIC_URL=/mail/
# Базовая авторизация ящика /mail/; обязательны при APP_ENV=production с Mailpit.
MAIL_UI_USER=
MAIL_UI_PASSWORD=

# --- демо-режим ------------------------------------------------------------------------------------------------------
DEMO_MODE=true
# Перезапуск сценария кнопкой для посетителей; false оставляет его только ведущему (публичный стенд, время питча).
DEMO_PUBLIC_RESTART=true
DEMO_CLONE_PER_IP_PER_HOUR=6
DEMO_CLONE_MAX=40
DEMO_CLONE_TTL_HOURS=24
# Пароль именованных демо-аккаунтов {key}@demo.test.
DEMO_PASSWORD=Demo-2026

# --- флаги усилений (сборочный пакет выставляет true после приёмки пакетов P1) ---------------------------------------
FEATURE_VACANCIES=false
FEATURE_PULSE=false
FEATURE_INTEGRATIONS=false
# Специализации без готовой очереди банка, через запятую.
DISABLED_SPECIALIZATIONS=
NEED_PARSER=rules
VALIDATION_DIR=docs/validation

# --- ФСП (Арх. 7.11) -------------------------------------------------------------------------------------------------
FSP_MODE=mock
FSP_MOCK_ENABLED=true
FSP_MOCK_ADMIN=true
FSPMOCK_AUTH=none
FSP_REFRESH_AFTER_HOURS=24
FSP_MANUAL_SYNC_MIN_INTERVAL_S=60
FSP_RETRY_MIN_INTERVAL_MIN=10
FSP_K_ANON=20
FSP_CONSENT_VERSION=fsp-data-1
FSP_SEED=20261005
FSP_SKILL_CORR=0.5

# --- константы механик -----------------------------------------------------------------------------------------------
# Переопределяются переменными CONTACT_*, ASSESSMENT_*, MATCHING_* (значения по умолчанию — Арх. 4.3, 5.10, 6.15).
# Если холодный старт не укладывается в 5 минут: ASSESSMENT_VARIANTS_PER_LEVEL=30, полный банк — make bank.
